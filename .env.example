# Copy to .env.local (never commit real values). Restart `npm run dev` after changing.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — needed to save orders after payment. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Account & Settings → API Keys (use rzp_test_… keys while testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks: URL https://YOUR-SITE/api/checkout/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# Resend (https://resend.com) → API Keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Magna Eco Bites <orders@your-domain.com>"

# Public site address, used in invitation links
NEXT_PUBLIC_SITE_URL=
